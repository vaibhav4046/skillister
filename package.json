{
  "name": "skillister",
  "version": "0.1.0",
  "description": "Find, route, and install agent skills across any agent CLI. Skill discovery that still works at a thousand skills.",
  "type": "module",
  "bin": {
    "skillister": "bin/skillister.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/validate.mjs && node test/eval.mjs",
    "validate": "node test/validate.mjs",
    "eval": "node test/eval.mjs",
    "index": "node bin/skillister.mjs index",
    "doctor": "node bin/skillister.mjs doctor"
  },
  "files": [
    "bin",
    "src",
    "registry",
    "skills",
    "adapters",
    "docs"
  ],
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "skills",
    "ai-agents",
    "mcp",
    "orchestrator"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaibhav4046/skillister.git"
  },
  "homepage": "https://github.com/vaibhav4046/skillister#readme",
  "bugs": {
    "url": "https://github.com/vaibhav4046/skillister/issues"
  }
}
